{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "https://fiis-matricula-api.onrender.com/api/$1"
    },
    {
      "src": "/django-admin/(.*)",
      "dest": "https://fiis-matricula-api.onrender.com/django-admin/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
