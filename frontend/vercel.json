{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "https://fiis-matricula-api-pwc6.onrender.com/api/$1"
    },
    {
      "src": "/django-admin/(.*)",
      "dest": "https://fiis-matricula-api-pwc6.onrender.com/django-admin/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
