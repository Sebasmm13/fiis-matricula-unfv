# Copiar a un archivo seguro y modificar para un despliegue real.
DATABASE_URL=postgresql://fiis:fiis_local@127.0.0.1:5432/fiis_matricula
DJANGO_SECRET_KEY=reemplazar_por_clave_aleatoria_larga
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
DJANGO_SECURE_COOKIES=0
DJANGO_SSL_REDIRECT=0
DJANGO_HSTS_SECONDS=0
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DJANGO_DEFAULT_FROM_EMAIL=no-responder@unfv.edu.pe
# Para producción configura además DJANGO_EMAIL_HOST, DJANGO_EMAIL_PORT,
# DJANGO_EMAIL_HOST_USER, DJANGO_EMAIL_HOST_PASSWORD y DJANGO_EMAIL_USE_TLS.

